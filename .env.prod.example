# Settings for docker-compose.prod.yml. Copy to .env on the server and fill in.
# .env is not committed.

# Password for the database. Make a long random one: openssl rand -base64 32
# Use letters and digits only, since it goes into a connection address.
POSTGRES_PASSWORD=

# The public addresses, without https://
WEB_DOMAIN=label-lens.cc
API_DOMAIN=api.label-lens.cc

# Optional: the Android app's page on Google Play.
# PLAY_URL=https://play.google.com/store/apps/details?id=com.hirusha.labellens

# Optional: where PostgreSQL keeps its files. Default: ./data beside the compose file.
# DATA_DIR=./data
