{
  "name": "labellens-api",
  "version": "0.1.0",
  "private": true,
  "description": "API for the Label Lens Android app. Serves the additive catalogue from PostgreSQL.",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "export:app": "node scripts/export-app-data.js",
    "test": "node --test test/catalogue.test.js test/app.test.js",
    "test:db": "node --env-file-if-exists=.env --test test/db.test.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=22"
  }
}
