{
  "name": "labellens-api",
  "version": "0.1.0",
  "private": true,
  "description": "API for the Label Lens Android app. Backed by Supabase.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.prod --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env.prod --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env.prod --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test test/catalogue.test.js test/app.test.js",
    "test:live": "node --env-file-if-exists=.env.prod --env-file-if-exists=.env --test test/live.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@supabase/middleware": "^1.0.0",
    "@supabase/server": "^1.9.1",
    "@supabase/supabase-js": "^2.117.3",
    "hono": "^4.13.13"
  },
  "engines": {
    "node": ">=22"
  }
}
