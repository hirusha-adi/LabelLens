# Copy to .env and fill in. Find these in the Supabase dashboard under
# Project Settings > API Keys.

SUPABASE_URL=https://<project-ref>.supabase.co

# Safe to ship in clients. Used for every request the API makes for a user.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses row level security. Server only: never commit it, never put it in the app.
# Needed for `pnpm seed`, logging out and deleting an account.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional. Where the confirmation link in the sign-up email sends people.
# Must also be listed under Authentication > URL Configuration > Redirect URLs.
# AUTH_REDIRECT_URL=https://api.example.com/auth/confirmed

# Optional.
# PORT=8787
# TRUST_PROXY=1          # read the caller's address from X-Forwarded-For (only behind your own proxy)
# FAIL_PURCHASE=1        # make every purchase fail, to see the app's error dialog
