# Copy to .env. These values match the development database in ../docker-compose.yml.

DATABASE_URL=postgres://labellens:labellens-dev@127.0.0.1:5440/labellens

# Optional.
# PORT=8787
# HOST=0.0.0.0
# LOG_REQUESTS=1   # print a line per request (development; slows a busy server)
# ALLOWED_ORIGINS=https://label-lens.example   # websites allowed to read the API from the browser, comma-separated
# TRUST_PROXY=1
# CLIENT_IP_HEADER=CF-Connecting-IP   # with TRUST_PROXY: the header a CDN puts the visitor's address in     # read the caller's address from X-Forwarded-For (only behind your own proxy)
