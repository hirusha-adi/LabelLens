<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The same single file as backup_rules.xml, for both cloud
     backup and moving directly to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="labellens_user.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="labellens_user.xml" />
    </device-transfer>
</data-extraction-rules>
