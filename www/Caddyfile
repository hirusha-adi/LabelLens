# Serves the built site inside the container. TLS and the public domain are
# handled by the server's own Caddy in front of this one.
{
	auto_https off
	admin off
}

:3000 {
	root * /srv
	encode zstd gzip

	# Fingerprinted build output, fonts and the text-recognition engine never
	# change under the same name.
	@forever path /assets/* /fonts/* /ocr/*
	header @forever Cache-Control "public, max-age=31536000, immutable"

	# The page itself must be rechecked, so a new release is picked up.
	@page path / /index.html /app /app/*
	header @page Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Every path under /app is the same single page.
	try_files {path} /index.html
	file_server
}
